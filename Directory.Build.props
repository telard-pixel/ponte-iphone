<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Authors>telard-pixel</Authors>
    <Product>Ponte iPhone</Product>
    <Copyright>telard-pixel</Copyright>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <!-- Avvisi del compilatore: visibili nei log della CI, non bloccanti. -->
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
</Project>
