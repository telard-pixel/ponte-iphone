# /etc/systemd/system/ponte-rapporti.service
# Ricevitore dei rapporti di Ponte iPhone (server-log.duckdns.org), dietro Caddy.
# Installato da server/installa.sh del repository ponte-iphone.
[Unit]
Description=Rapporti di Ponte iPhone
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/python3 -I /opt/ponte-rapporti/rapporti_ponte.py
Restart=on-failure
RestartSec=5
Environment=PORTA=8084
# Chat del proprietario sul bot del server (lo stesso degli avvisi di node-health).
Environment=CHAT_ID=8233212

# Utente di sistema creato al volo da systemd: niente account fisso sulla VPS.
DynamicUser=yes
StateDirectory=ponte-rapporti
StateDirectoryMode=0700
LoadCredential=bot-token:/etc/ponte-rapporti/bot-token

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
MemoryMax=200M

[Install]
WantedBy=multi-user.target
