<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>PonteIPhone</AssemblyName>
    <RootNamespace>PonteIPhone</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>PonteIPhone.Program</StartupObject>
    <!-- Main scritto a mano (Program.cs): lo stesso eseguibile fa anche da processo per l'iPhone. -->
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <SatelliteResourceLanguages>it</SatelliteResourceLanguages>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="app.ico" />
    <EmbeddedResource Include="PonteIPhone.cer" LogicalName="PonteIPhone.cer" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.0.3" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PonteIPhone.Core\PonteIPhone.Core.csproj" />
    <ProjectReference Include="..\PonteIPhone.Wpd\PonteIPhone.Wpd.csproj" />
  </ItemGroup>
</Project>
